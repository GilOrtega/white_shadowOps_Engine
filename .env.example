# --- App (agentes con IA: Nutri por foto y análisis del Coach) ---
ANTHROPIC_API_KEY=
# Solo si tu llave NO se creó dentro de un workspace de la consola de Anthropic (wrkspc_...)
ANTHROPIC_WORKSPACE_ID=
# Frase larga que tú inventas; la misma se escribe en Ajustes → Clave de acceso
WSO_API_SECRET=
# Opcionales (por defecto usan el modelo más barato)
# WSO_VISION_MODEL=claude-haiku-5-5
# WSO_COACH_MODEL=claude-haiku-5-5

# --- Motor de shorts (corre en tu compu) ---
DEEPGRAM_API_KEY=
WSO_MINER_MODEL=claude-sonnet-5-5
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe

# --- Avisos push "Rapo a la 0" (npm run push:keys los genera) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com
# Vercel lo manda en el header Authorization de los crons.
CRON_SECRET=
# Upstash Redis (Vercel → Storage → Marketplace) — se llenan solas al conectarlo.
KV_REST_API_URL=
KV_REST_API_TOKEN=
